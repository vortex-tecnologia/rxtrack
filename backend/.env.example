# =============================================================
# QuickTrack - Variáveis de Ambiente
# =============================================================
# INSTRUÇÕES PARA DEPLOY:
#   1. Copie este arquivo:  cp .env.example .env
#   2. Preencha os campos marcados com ⚠️ [OBRIGATÓRIO]
#   3. Os campos marcados com 🔧 [CONFIGURAR DEPOIS] serão
#      preenchidos pelo desenvolvedor via Portainer após o deploy
#   4. Execute: docker compose up -d
# =============================================================

# ─────────────────────────────────────────────
# ⚠️ [OBRIGATÓRIO] DJANGO CORE
# ─────────────────────────────────────────────
SECRET_KEY=nWDsuegAkySKzvEail-a8gcwiKnnZIY94dPQ9hDqRyvpXXeNOElF_5mmqJcKXRtQkdE
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
CSRF_TRUSTED_ORIGINS=https://localhost

# CORS
CORS_ALLOWED_ORIGINS=

# ─────────────────────────────────────────────
# ⚠️ [OBRIGATÓRIO] BANCO DE DADOS MySQL
# ─────────────────────────────────────────────
# Produção: porta 3308 | Homologação: porta 3307
DB_NAME=PREENCHER_NOME_DO_BANCO
DB_USER=PREENCHER_USUARIO
DB_PASSWORD=PREENCHER_SENHA
DB_HOST=host.docker.internal
DB_PORT=3308

# ─────────────────────────────────────────────
# REDIS / CELERY (não alterar)
# ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─────────────────────────────────────────────
# 🔧 [CONFIGURAR DEPOIS] FTP - Storage de Imagens
# O desenvolvedor preencherá via Portainer
# ─────────────────────────────────────────────
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_BASE_URL=

# ─────────────────────────────────────────────
# 🔧 [CONFIGURAR DEPOIS] EMAIL SMTP
# O desenvolvedor preencherá via Portainer
# ─────────────────────────────────────────────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ─────────────────────────────────────────────
# 🔧 [CONFIGURAR DEPOIS] TMS Integration
# ─────────────────────────────────────────────
TMS_DATAEXPORT_BASE_URL=
TMS_API_KEY=
# Senha para autenticação do webhook TMS direto (Comprovei/SSW JSON)
# Enviada pelo TMS dentro do body: Envelope.Header.Credenciais.Senha
TMS_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# 🔧 [CONFIGURAR DEPOIS] WebPush / Notificações
# ─────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=

# ─────────────────────────────────────────────
# PORTAINER - Gestão Docker (porta 9000)
# Senha já configurada no docker-compose.yml
# ─────────────────────────────────────────────
PORTAINER_ADMIN_PASSWORD=QuickTrack@2026!
